<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primario">#1F3A68</Color>
    <Color x:Key="PrimarioOscuro">#14284A</Color>
    <Color x:Key="Acento">#C0392B</Color>
    <Color x:Key="Exito">#1E7F4F</Color>
    <Color x:Key="Fondo">#F4F6FA</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Texto">#1B2430</Color>
    <Color x:Key="TextoSuave">#5B6675</Color>
    <Color x:Key="Borde">#D5DBE5</Color>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Primario}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ErrorCampo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Acento}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Nota" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primario}" />
        <Setter Property="BorderColor" Value="{StaticResource Primario}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Stroke" Value="{StaticResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="20" />
    </Style>

</ResourceDictionary>
