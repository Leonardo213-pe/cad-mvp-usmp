<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             x:Class="Cad.Movil.Vistas.Ciudadano.InicioCiudadanoPage"
             x:DataType="vm:InicioCiudadanoViewModel"
             Title="Ciudadano">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Command="{Binding CerrarSesionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Hola" Style="{StaticResource Subtitulo}" />
            <Label Text="{Binding Email}" Style="{StaticResource Titulo}" FontSize="20" />
        </VerticalStackLayout>

        <!-- HU06: estado de la ubicación. Solo informa; no transmite nada (RNF07). -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="14">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <Grid Grid.Row="0" Grid.Column="0" WidthRequest="12" VerticalOptions="Start" Margin="0,5,0,0">
                    <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="{StaticResource Acento}">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding UbicacionLista}" Value="True">
                                <Setter Property="Color" Value="{StaticResource Exito}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                    <ActivityIndicator IsRunning="{Binding Comprobando}" IsVisible="{Binding Comprobando}"
                                       WidthRequest="16" HeightRequest="16" Color="{StaticResource Primario}" />
                </Grid>

                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                    <Label Text="{Binding Detalle}" Style="{StaticResource Subtitulo}" FontSize="13" />
                </VerticalStackLayout>

                <Button Grid.Row="1" Grid.Column="1" Text="{Binding TextoAccion}" IsVisible="{Binding HayAccion}"
                        Command="{Binding EjecutarAccionCommand}" Style="{StaticResource BotonSecundario}"
                        HeightRequest="40" FontSize="14" HorizontalOptions="Start" Padding="16,0" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="16" VerticalOptions="Center">
            <!-- RF03.1 / RNF06: control independiente del reporte y del acompañamiento; un solo toque, sin
                 formularios ni confirmación. Mientras se envía no admite otra pulsación. -->
            <Border WidthRequest="210" HeightRequest="210" HorizontalOptions="Center"
                    BackgroundColor="{StaticResource Acento}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 105"
                    SemanticProperties.Description="Botón SOS. Envía una alerta urgente a la central.">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Sos.EmitirCommand}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Sos.EnCurso}" Value="True">
                        <Setter Property="Opacity" Value="0.7" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                    <Label Text="SOS" TextColor="White" FontSize="56" FontAttributes="Bold" HorizontalOptions="Center" />
                    <ActivityIndicator IsRunning="{Binding Sos.EnCurso}" IsVisible="{Binding Sos.EnCurso}"
                                       Color="White" WidthRequest="22" HeightRequest="22" />
                    <Label Text="{Binding Sos.TextoBoton}" TextColor="White" FontSize="13"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Resultado: "SOS registrado" solo aparece cuando respondió el servidor (HU07-CA03). -->
            <Border Style="{StaticResource Tarjeta}" Padding="14" IsVisible="{Binding Sos.HayResultado}"
                    Stroke="{StaticResource Acento}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Sos.Registrado}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Exito}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Sos.Titulo}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Acento}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Sos.Registrado}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Exito}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding Sos.Detalle}" Style="{StaticResource Subtitulo}" FontSize="13" />
                    <Button Text="Reintentar" IsVisible="{Binding Sos.PuedeReintentar}"
                            Command="{Binding Sos.EmitirCommand}" Style="{StaticResource BotonPrimario}"
                            BackgroundColor="{StaticResource Acento}" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Ante peligro inmediato pulsa SOS: un solo toque, sin formularios."
                   Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="14" Opacity="0.6">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Reportar incidencia" FontAttributes="Bold" />
                        <Label Text="Próximamente" Style="{StaticResource Subtitulo}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="14" Opacity="0.6">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Acompañamiento" FontAttributes="Bold" />
                        <Label Text="Próximamente" Style="{StaticResource Subtitulo}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Tarjeta}" Padding="14" Opacity="0.6">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Mis casos" FontAttributes="Bold" />
                    <Label Text="Próximamente" Style="{StaticResource Subtitulo}" FontSize="12" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Label Grid.Row="3" Style="{StaticResource Nota}"
               Text="MVP académico · datos simulados · no es un canal oficial de emergencias" />
    </Grid>
</ContentPage>
